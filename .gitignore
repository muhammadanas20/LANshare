# dependencies
node_modules/
server/node_modules/

# builds (regenerate with `npm run build`, `npm run build:single`, `npm run bundle:offline`)
dist/
dist-offline/
server/dist/
*.tsbuildinfo

# downloaded browser binaries for the end-to-end suites (never source)
.config/
.cache/

# npm's own cache, created under $HOME when installs run inside this directory
.npm/

# scratch left behind by `sudo` inside containers
.sudo_as_admin_successful

# environment
.env
.env.local
.env.*.local

# test + tooling output
coverage/
.vite/
*.log

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local TLS material for the offline LAN mode (generated by `npm run cert`)
server/.certs/
