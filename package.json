{
  "name": "lanshare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LANShare — fast, private, AirDrop-like file & media sharing between nearby devices. Built by Muhammad Anas.",
  "license": "MIT",
  "author": "Muhammad Anas",
  "scripts": {
    "dev": "vite --host",
    "dev:secure": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:server": "npm --prefix server run test",
    "test:all": "npm run test && npm run test:server && npm run e2e && npm run e2e:offline && npm run e2e:serverless && npm run e2e:single-file",
    "e2e": "node scripts/e2e/run.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "serve:signaling": "npm --prefix server run dev",
    "start:all": "node scripts/dev-all.mjs",
    "e2e:reconnect": "node scripts/e2e/reconnect.mjs",
    "verify:docker": "node scripts/verify-dockerfile.mjs",
    "e2e:pages": "node scripts/e2e/pages-deploy.mjs",
    "probe:live": "node scripts/live-probe.cjs",
    "offline": "node scripts/offline.mjs",
    "offline:secure": "node scripts/offline.mjs --secure",
    "cert": "node scripts/make-cert.mjs",
    "e2e:offline": "node scripts/e2e/offline-lan.mjs",
    "e2e:serverless": "node scripts/e2e/serverless.mjs",
    "build:single": "VITE_SINGLE_FILE=1 vite build && node scripts/build-single-file.mjs",
    "e2e:single-file": "node scripts/e2e/single-file.mjs",
    "bundle:offline": "node scripts/bundle-offline.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^0.454.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  },
  "browserslist": [
    "Chrome >= 100",
    "Firefox >= 100",
    "Safari >= 15.4",
    "Edge >= 100"
  ]
}
