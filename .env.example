# ---- Signaling server (Node) -------------------------------------------------
# Copy to `.env` (or export the variables) before `npm run serve:signaling`.
# Every value has a working default, so an empty file is valid.

# Port / interface the WebSocket server listens on.
PORT=8080
HOST=0.0.0.0

# Comma-separated Origin allow-list for the WebSocket upgrade.
# Leave empty to accept any origin (handy for LAN use, less strict).
ALLOWED_ORIGINS=

# Room every device joins by default, so two devices on the same network find
# each other with zero setup. Private rooms stay opt-in (room code / QR link).
DEFAULT_ROOM=NEARBY
MAX_PEERS_PER_ROOM=8
MAX_ROOMS=5000

# Signaling frames carry SDP/ICE only, so this can stay small.
MAX_MESSAGE_BYTES=65536

# Room lifecycle + WebSocket heartbeat.
ROOM_TTL_MS=43200000
SWEEP_INTERVAL_MS=60000
HEARTBEAT_INTERVAL_MS=30000
HELLO_TIMEOUT_MS=10000

# ICE servers handed to browsers. STUN is enough on most home/office LANs;
# add TURN when the two devices sit behind symmetric NATs.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# When set, short-lived TURN credentials are derived from this secret
# (HMAC, coturn `use-auth-secret` style) instead of a static password.
TURN_SECRET=

# ---- Frontend (Vite) ---------------------------------------------------------
# Base path for GitHub Pages project sites, e.g. /lanshare/
VITE_BASE_PATH=/
# WebSocket URL of the signaling server. Empty = same origin (the dev server
# proxies /ws to SIGNALING_PROXY_TARGET).
VITE_SIGNALING_URL=
# Dev-only proxy target used by `vite dev` / `vite preview`.
SIGNALING_PROXY_TARGET=http://localhost:8080

# ── Offline LAN mode (`npm run offline`) ──────────────────────────────────────
# One process serves the built frontend *and* the signaling WebSocket, and advertises no
# external ICE servers, so devices on the same network can share files with no internet.
# `npm run offline` sets the first three for you; they are documented for custom setups.
SERVE_STATIC=false            # true = serve dist/ from the signaling server
STATIC_ROOT=../dist           # build directory to serve (relative to server/)
OFFLINE_MODE=false           # true = no external STUN/TURN, host candidates only
TLS_CERT=                    # PEM certificate path (optional; only needed for PWA install)
TLS_KEY=                     # PEM private key path
# Optional: the single-file offline app, offered for download at /LANShare.html so a phone can
# keep a copy that works with no server at all (`npm run build:single` creates it).
SINGLE_FILE_PATH=
